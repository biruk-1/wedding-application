# Local Edge Function secrets (NOT the Expo app .env)
# Copy to supabase/.env and fill in your Chapa TEST secret from dashboard.chapa.co
#
# Serve with:
#   npx supabase functions serve --env-file supabase/.env

CHAPA_SECRET_KEY=CHASECK_TEST-replace-me
CHAPA_VENDOR_SPLIT_VALUE=0.95
CHAPA_ALLOW_UNSIGNED_WEBHOOKS=true
