# Local Supabase (after: npm run db:start && npm run db:status)
# For Expo Go on a phone, either keep 127.0.0.1 (auto-rewritten to Metro LAN IP)
# or set your PC Wi-Fi IP explicitly, e.g. http://10.249.56.80:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# Optional: scripts / CI only — NEVER ship in the Expo app or commit real values
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chapa — put these in supabase/.env for local `functions serve --env-file supabase/.env`
# (or `supabase secrets set` on a linked cloud project). Never put the secret in Expo.
# CHAPA_SECRET_KEY=CHASECK_TEST-...
# CHAPA_VENDOR_SPLIT_VALUE=0.95
# CHAPA_ALLOW_UNSIGNED_WEBHOOKS=true
# CHAPA_ALLOW_SMOKE_TEST=true
#
# Optional Expo flag to show the smoke-test entry even if URL does not look local:
# EXPO_PUBLIC_ALLOW_CHAPA_SMOKE_TEST=1
