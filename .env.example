# Local Supabase (after: npm run db:start && npm run db:status)
# For Expo Go on a phone, either keep 127.0.0.1 (auto-rewritten to Metro LAN IP)
# or set your PC Wi-Fi IP explicitly, e.g. http://10.249.56.80:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# Optional: scripts / CI only — NEVER ship in the Expo app or commit real values
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
